<Window x:Class="DatasheetGenerator.SchemaEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="스키마 편집기"
        Height="600"
        MinHeight="400"
        Width="700"
        MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="Assets/app_icon.png"
        Loaded="WindowLoaded"
        PreviewKeyDown="WindowPreviewKeyDown">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Padding" Value="16,6"/>
      <Setter Property="MinWidth" Value="80"/>
    </Style>
  </Window.Resources>

  <DockPanel Background="#F5F7FA">
    <Border DockPanel.Dock="Top"
            Background="#FFFFFF"
            BorderBrush="#D9DEE8"
            BorderThickness="0,0,0,1"
            Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="파일명"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"/>
        <TextBox x:Name="fileNameTextBox"
                 Grid.Column="1"
                 Padding="6,4"
                 Margin="0"
                 TextChanged="FileNameTextChanged"/>
        <TextBlock Grid.Column="2"
                   Text=".schema.json"
                   VerticalAlignment="Center"
                   Foreground="#596579"
                   Margin="4,0,0,0"/>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom"
            Background="#FFFFFF"
            BorderBrush="#D9DEE8"
            BorderThickness="0,1,0,0"
            Padding="12,8">
      <StackPanel>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
          <Button Content="정렬" Click="FormatClick"/>
          <Button Content="취소" Click="CancelClick"/>
          <Button x:Name="saveButton" Content="저장" FontWeight="SemiBold" Click="SaveClick"/>
        </StackPanel>
        <TextBlock x:Name="validationTextBlock"
                   Foreground="#C0392B"
                   TextWrapping="Wrap"
                   Margin="4,2,4,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers>
                <Trigger Property="Text" Value="">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </Border>

    <Border Margin="12"
            BorderBrush="#D9DEE8"
            BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBox x:Name="lineNumbersTextBox"
                 Grid.Column="0"
                 IsReadOnly="True"
                 Focusable="False"
                 IsHitTestVisible="False"
                 FontFamily="Consolas, Courier New"
                 FontSize="13"
                 Padding="6,8,6,8"
                 Background="#F0F2F5"
                 Foreground="#8A9BBF"
                 BorderThickness="0,0,1,0"
                 BorderBrush="#D9DEE8"
                 VerticalScrollBarVisibility="Hidden"
                 HorizontalScrollBarVisibility="Disabled"
                 TextAlignment="Right"
                 MinWidth="36"/>

        <TextBox x:Name="schemaTextBox"
                 Grid.Column="1"
                 Padding="8"
                 FontFamily="Consolas, Courier New"
                 FontSize="13"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 TextChanged="SchemaTextChanged"
                 PreviewKeyDown="SchemaTextBoxPreviewKeyDown"
                 BorderThickness="0"/>
      </Grid>
    </Border>
  </DockPanel>
</Window>
