<Window x:Class="DatasheetGenerator.DataEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Height="600"
        MinHeight="400"
        Width="1000"
        MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="Assets/app_icon.png">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="MinWidth" Value="80"/>
    </Style>
  </Window.Resources>

  <DockPanel Background="#F5F7FA">
    <Border DockPanel.Dock="Bottom"
            Background="#FFFFFF"
            BorderBrush="#D9DEE8"
            BorderThickness="0,1,0,0"
            Padding="12,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Button x:Name="addRowButton" Content="+ Add Row" Click="AddRowClick" IsEnabled="False"/>
          <Button x:Name="deleteRowButton" Content="- Delete Row" Click="DeleteRowClick" IsEnabled="False"/>
          <Button x:Name="validateButton" Content="검증" Click="ValidateClick" IsEnabled="False"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
          <Button Content="Cancel" Click="CancelClick"/>
          <Button x:Name="saveButton" Content="Save" FontWeight="SemiBold" Click="SaveClick" IsEnabled="False"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top"
            Background="#FFF8E7"
            BorderBrush="#F0D080"
            BorderThickness="0,0,0,1"
            Padding="10,4">
      <TextBlock Text="★ = Required 컬럼"
                 FontSize="11"
                 Foreground="#806000"/>
    </Border>

    <wv2:WebView2 x:Name="webView"/>
  </DockPanel>
</Window>
