<Window x:Class="DatasheetGenerator.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input"
        Height="170"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="messageTextBlock" Grid.Row="0" FontWeight="SemiBold"/>
    <TextBox x:Name="inputTextBox" Grid.Row="1" Margin="0,10,0,0" Padding="6"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="OK" Width="84" Margin="4" Padding="8,5" IsDefault="True" Click="OkClick"/>
      <Button Content="Cancel" Width="84" Margin="4" Padding="8,5" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
