<Window x:Class="DatasheetGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datasheet Generator"
        Height="580"
        MinHeight="420"
        Width="800"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app_icon.png">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="MinWidth" Value="90"/>
    </Style>
  </Window.Resources>

  <DockPanel Background="#F5F7FA">
    <Border DockPanel.Dock="Top"
            Background="#FFFFFF"
            BorderBrush="#D9DEE8"
            BorderThickness="0,0,0,1"
            Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Datasheet Generator" FontSize="18" FontWeight="SemiBold"/>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <Button Content="파일 위치 열기" Padding="8,4" MinWidth="0" Click="OpenSchemaFolderClick"/>
          <Button Content="Config 수정" Padding="8,4" MinWidth="0" Click="OpenConfigFileClick"/>
        </StackPanel>
      </Grid>
    </Border>

    <StatusBar DockPanel.Dock="Bottom"
               Background="#FFFFFF"
               BorderBrush="#D9DEE8"
               BorderThickness="0,1,0,0">
      <StatusBarItem>
        <TextBlock x:Name="statusTextBlock" Text="Ready"/>
      </StatusBarItem>
    </StatusBar>

    <Grid Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="#FFFFFF"
              BorderBrush="#D9DEE8"
              BorderThickness="1"
              Padding="12">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="스키마 목록"
                       FontSize="15"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Content="초기화"
                    Padding="6,2"
                    MinWidth="0"
                    Margin="4,0,0,0"
                    Click="ClearSchemaListClick"/>
            <Button Grid.Column="2"
                    Content="불러오기"
                    Padding="6,2"
                    MinWidth="0"
                    Margin="4,0,0,0"
                    Click="LoadSchemaClick"/>
          </Grid>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBox x:Name="schemaSearchBox"
                     Padding="4,3"
                     BorderBrush="#D9DEE8"
                     BorderThickness="1"
                     TextChanged="SchemaSearchChanged"/>
            <TextBlock Text="검색"
                       Foreground="#AAAAAA"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=schemaSearchBox}" Value="">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <UniformGrid DockPanel.Dock="Bottom"
                       Rows="2"
                       Columns="2"
                       Margin="0,8,0,0">
            <Button Content="추가" Click="NewSchemaClick"/>
            <Button x:Name="deleteSchemaButton"
                    Content="삭제"
                    IsEnabled="False"
                    Click="DeleteSchemaClick"/>
            <Button x:Name="renameSchemaButton"
                    Content="이름 변경"
                    IsEnabled="False"
                    Click="RenameSchemaClick"/>
            <Button Content="갱신" Click="RefreshSchemaListClick"/>
          </UniformGrid>
          <ListBox x:Name="schemaListBox"
                   DisplayMemberPath="Name"
                   SelectionChanged="SchemaSelectionChanged"
                   BorderBrush="#D9DEE8"
                   BorderThickness="1"/>
        </DockPanel>
      </Border>

      <Border Grid.Column="1"
              Background="#FFFFFF"
              BorderBrush="#D9DEE8"
              BorderThickness="1"
              Margin="12,0,0,0"
              Padding="16">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Margin="0,12,0,0">
            <Button x:Name="schemaGraphButton"
                    Content="구조 보기"
                    IsEnabled="False"
                    Click="SchemaGraphClick"/>
            <Button x:Name="editSchemaButton"
                    Content="스키마 편집"
                    IsEnabled="False"
                    Click="EditSchemaClick"/>
            <Button x:Name="dataEntryButton"
                    Content="데이터 입력"
                    IsEnabled="False"
                    FontWeight="SemiBold"
                    Click="DataEntryClick"/>
          </StackPanel>

          <ScrollViewer x:Name="schemaInfoPanel"
                        Visibility="Collapsed"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock x:Name="schemaNameTextBlock"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Margin="0,0,0,8"/>
              <TextBlock Text="컬럼 미리보기"
                         FontWeight="SemiBold"
                         Margin="0,0,0,6"/>
              <ItemsControl x:Name="columnPreviewList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Margin="0,2"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <TextBlock x:Name="noSelectionTextBlock"
                     Text="스키마를 선택하세요."
                     Foreground="#596579"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
