<Window x:Class="DatasheetGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datasheet Generator"
        Height="580"
        MinHeight="420"
        Width="860"
        MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app_icon.png">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="MinWidth" Value="0"/>
    </Style>
    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#596579"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E8ECF5"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#D0D6EB"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#5C6BC0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#5C6BC0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="MinWidth" Value="110"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#4A5BAE"/>
                <Setter Property="BorderBrush" Value="#4A5BAE"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#3A4C9D"/>
                <Setter Property="BorderBrush" Value="#3A4C9D"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#B0B8E4"/>
                <Setter Property="BorderBrush" Value="#B0B8E4"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#5C6BC0"/>
      <Setter Property="BorderBrush" Value="#BDC6E0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="MinWidth" Value="110"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#EEF0F9"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#DDE0F4"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#B0B8E4"/>
                <Setter Property="BorderBrush" Value="#D9DFF0"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel Background="#F5F7FA">
    <Border DockPanel.Dock="Top"
            Background="#FFFFFF"
            BorderBrush="#D9DEE8"
            BorderThickness="0,0,0,1"
            Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Datasheet Generator" FontSize="18" FontWeight="SemiBold"/>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <Button Content="파일 위치 열기" Padding="8,4" Click="OpenSchemaFolderClick"/>
          <Button Content="Config 수정" Padding="8,4" Margin="4,0,0,0" Click="OpenConfigFileClick"/>
        </StackPanel>
      </Grid>
    </Border>

    <StatusBar DockPanel.Dock="Bottom"
               Background="#FFFFFF"
               BorderBrush="#D9DEE8"
               BorderThickness="0,1,0,0">
      <StatusBarItem>
        <TextBlock x:Name="statusTextBlock" Text="Ready"/>
      </StatusBarItem>
    </StatusBar>

    <Grid Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left panel: schema list -->
      <Border Grid.Column="0"
              Background="#FFFFFF"
              BorderBrush="#D9DEE8"
              BorderThickness="1">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="12,10,8,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="스키마"
                       FontSize="15"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Content="↻"
                    Style="{StaticResource FlatButton}"
                    FontSize="15"
                    Click="RefreshSchemaListClick"/>
          </Grid>

          <Grid DockPanel.Dock="Top" Margin="10,0,10,8">
            <TextBox x:Name="schemaSearchBox"
                     Padding="4,3"
                     BorderBrush="#D9DEE8"
                     BorderThickness="1"
                     TextChanged="SchemaSearchChanged"/>
            <TextBlock Text="검색"
                       Foreground="#AAAAAA"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=schemaSearchBox}" Value="">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>

          <Button DockPanel.Dock="Bottom"
                  Content="+ 새 스키마"
                  Margin="10,6,10,10"
                  Padding="0,8"
                  Click="NewSchemaClick"/>

          <ListBox x:Name="schemaListBox"
                   Margin="6,0,6,0"
                   BorderBrush="#D9DEE8"
                   BorderThickness="1"
                   SelectionChanged="SchemaSelectionChanged">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="2,1"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0"
                             Text="{Binding Name}"
                             VerticalAlignment="Center"
                             Margin="4,3"/>
                  <Button Grid.Column="1"
                          Content="⋮"
                          Style="{StaticResource FlatButton}"
                          FontSize="14"
                          Padding="6,2"
                          VerticalAlignment="Center"
                          Click="SchemaMenuButtonClick">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="이름 변경" Click="RenameSchemaMenuClick"/>
                        <MenuItem Header="삭제" Click="DeleteSchemaMenuClick"/>
                      </ContextMenu>
                    </Button.ContextMenu>
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Right panel: info area -->
      <Border Grid.Column="1"
              Background="#FFFFFF"
              BorderBrush="#D9DEE8"
              BorderThickness="1"
              Margin="12,0,0,0">
        <Grid>
          <StackPanel x:Name="noSelectionPanel"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center">
            <TextBlock Text="좌측에서 스키마를 선택하거나 새 스키마를 추가하세요."
                       Foreground="#596579"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="280"/>
          </StackPanel>

          <ScrollViewer x:Name="schemaInfoPanel"
                        Visibility="Collapsed"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
              <TextBlock x:Name="schemaNameTextBlock"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Margin="0,0,0,12"/>

              <TextBlock Text="상태"
                         FontWeight="SemiBold"
                         Foreground="#596579"
                         Margin="0,0,0,6"/>
              <Border Background="#F8F9FD"
                      BorderBrush="#E4E8F4"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="14,12"
                      Margin="0,0,0,20">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="필드 수" Foreground="#7A8499" Margin="0,0,24,8"/>
                  <TextBlock x:Name="fieldCountText" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="데이터 행" Foreground="#7A8499" Margin="0,0,24,8"/>
                  <TextBlock x:Name="dataRowCountText" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="참조 필드" Foreground="#7A8499" Margin="0,0,24,8"/>
                  <TextBlock x:Name="refFieldCountText" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold"/>
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="마지막 수정일" Foreground="#7A8499" Margin="0,0,24,0"/>
                  <TextBlock x:Name="lastModifiedText" Grid.Row="3" Grid.Column="1" FontWeight="SemiBold"/>
                </Grid>
              </Border>

              <TextBlock Text="주요 작업"
                         FontWeight="SemiBold"
                         Foreground="#596579"
                         Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button x:Name="editSchemaButton"
                        Content="스키마 편집"
                        Style="{StaticResource PrimaryButton}"
                        IsEnabled="False"
                        Click="EditSchemaClick"/>
                <Button x:Name="dataEntryButton"
                        Content="데이터 입력"
                        Style="{StaticResource PrimaryButton}"
                        IsEnabled="False"
                        Click="DataEntryClick"/>
              </StackPanel>

              <Separator Margin="0,0,0,16" Background="#E4E8F4"/>

              <TextBlock Text="확인 / 생성"
                         FontWeight="SemiBold"
                         Foreground="#596579"
                         Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="schemaGraphButton"
                        Content="참조 구조 보기"
                        Style="{StaticResource SecondaryButton}"
                        IsEnabled="False"
                        Click="SchemaGraphClick"/>
                <Button x:Name="codeViewButton"
                        Content="C# 코드 보기"
                        Style="{StaticResource SecondaryButton}"
                        IsEnabled="False"
                        Click="CodeViewClick"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
